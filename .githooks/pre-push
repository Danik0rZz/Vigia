#!/bin/sh
# Puerta sin IA (ADR-0007): antes de publicar, restos del tenant de pruebas (sin mostrar valores).
# Se activa una vez por clon: git config core.hooksPath .githooks
# scan-tenant.mjs solo usa módulos de Node: no necesita node_modules. Lee .env.live.local de la
# carpeta desde la que se hace el push (el checkout principal).

echo "pre-push › scan:tenant"
node scripts/scan-tenant.mjs || { echo "pre-push: scan:tenant ha encontrado restos del tenant. No se publica."; exit 1; }
exit 0
