{
  "always": ["e2e/smoke.spec.ts"],
  "ignore": [
    "docs/**",
    "**/*.md",
    "src/**/*.test.ts",
    "src/**/*.live.test.ts",
    "scripts/**",
    "src/test/**",
    "vitest.config.ts",
    "vitest.live.config.ts",
    "drizzle.config.ts",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.yaml",
    ".editorconfig",
    "eslint.config.mjs"
  ],
  "transversal": [
    "src/shared/ipc.ts",
    "src/shared/app.ts",
    "src/preload/**",
    "src/main/ipc/handler.ts",
    "src/main/ipc/register.ts",
    "src/main/security/**",
    "src/main/index.ts",
    "src/main/window.ts",
    "src/main/paths.ts",
    "src/main/protocol.ts",
    "src/main/user-agent.ts",
    "src/main/user-data.ts",
    "src/main/local-data.ts",
    "src/main/logging.ts",
    "src/main/errors.ts",
    "src/main/db/**",
    "src/renderer/index.html",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/lib/**",
    "src/renderer/src/app/Layout.tsx",
    "src/renderer/src/app/router.tsx",
    "src/renderer/src/app/navigation.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/src/App.tsx",
    "src/renderer/src/assets/**",
    "package.json",
    "package-lock.json",
    "electron.vite.config.ts",
    "electron-builder.yml",
    "playwright.config.ts",
    "tsconfig*.json",
    ".gitattributes",
    "build/**",
    "e2e/areas.json"
  ],
  "areas": {
    "smoke": {
      "globs": ["src/main/ipc/handlers/app.ts"],
      "specs": ["e2e/smoke.spec.ts"]
    },
    "tenants": {
      "globs": [
        "src/main/tenants/**",
        "src/main/secrets/**",
        "src/main/settings/**",
        "src/main/ipc/handlers/tenants.ts",
        "src/shared/tenants.ts",
        "src/renderer/src/settings/**",
        "src/renderer/src/data/tenants.ts",
        "src/renderer/src/data/environment-label.ts",
        "src/renderer/src/components/EnvSelector.tsx",
        "src/renderer/src/components/EnvTypeBadge.tsx",
        "src/renderer/src/components/EnvStatusCard.tsx",
        "src/renderer/src/components/CommandPalette.tsx",
        "src/renderer/src/components/dialogs.tsx",
        "src/renderer/src/components/Field.tsx",
        "src/renderer/src/pages/SettingsPage.tsx",
        "src/renderer/src/locales/**"
      ],
      "specs": ["e2e/tenants.spec.ts"]
    },
    "tls": {
      "globs": [
        "src/main/dynatrace/**",
        "src/main/ipc/handlers/connection.ts",
        "src/shared/dynatrace.ts",
        "src/renderer/src/settings/ConnectionPanel.tsx",
        "src/renderer/src/settings/SecretsPanel.tsx",
        "src/renderer/src/settings/EnvironmentForm.tsx",
        "src/renderer/src/components/EnvStatusCard.tsx",
        "src/renderer/src/locales/**"
      ],
      "specs": ["e2e/tls.spec.ts"]
    },
    "views": {
      "globs": [
        "src/renderer/src/pages/**",
        "src/renderer/src/components/Chart.tsx",
        "src/renderer/src/components/ExportMenu.tsx",
        "src/renderer/src/components/ModuleState.tsx",
        "src/renderer/src/components/ProblemDetail.tsx",
        "src/renderer/src/components/ProblemsTable.tsx",
        "src/renderer/src/components/PageHeader.tsx",
        "src/renderer/src/components/TimeRangeSelector.tsx",
        "src/renderer/src/components/CommandPalette.tsx",
        "src/renderer/src/data/modules.ts",
        "src/renderer/src/app/time-range.ts",
        "src/renderer/src/settings/ExportSettingsSection.tsx",
        "src/main/export/**",
        "src/main/modules/**",
        "src/main/ipc/handlers/modules.ts",
        "src/main/ipc/handlers/export.ts",
        "src/main/dynatrace/**",
        "src/shared/dynatrace.ts",
        "src/shared/modules.ts",
        "src/shared/problem-row.ts",
        "src/shared/format-date.ts",
        "src/shared/time-range.ts",
        "src/shared/dt-endpoints.ts",
        "src/renderer/src/locales/**"
      ],
      "specs": ["e2e/views.spec.ts"]
    },
    "shell": {
      "globs": [
        "src/renderer/src/components/Sidebar.tsx",
        "src/renderer/src/components/TopBar.tsx",
        "src/renderer/src/components/EnvStatusCard.tsx",
        "src/renderer/src/components/TimeRangeSelector.tsx",
        "src/renderer/src/components/CommandPalette.tsx",
        "src/renderer/src/components/OptionGroup.tsx",
        "src/renderer/src/components/PageHeader.tsx",
        "src/renderer/src/components/styles.ts",
        "src/renderer/src/app/theme.ts",
        "src/renderer/src/app/i18n.ts",
        "src/renderer/src/app/preferences.ts",
        "src/renderer/src/app/time-range.ts",
        "src/renderer/src/pages/SectionPage.tsx",
        "src/renderer/src/pages/SettingsPage.tsx",
        "src/main/theme.ts",
        "src/main/ipc/handlers/ui.ts",
        "src/renderer/src/locales/**"
      ],
      "specs": ["e2e/shell.spec.ts"]
    }
  }
}
