{
  "always": ["e2e/smoke.spec.ts"],
  "ignore": [
    "docs/**",
    "**/*.md",
    "src/**/*.test.ts",
    "src/**/*.live.test.ts",
    "scripts/**",
    "src/test/**",
    "vitest.config.ts",
    "vitest.live.config.ts",
    "drizzle.config.ts",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.yaml",
    ".editorconfig",
    "eslint.config.mjs",
    ".claude/**",
    ".githooks/**",
    ".github/**"
  ],
  "transversal": [
    "src/shared/ipc.ts",
    "src/shared/app.ts",
    "src/preload/**",
    "src/main/ipc/handler.ts",
    "src/main/ipc/register.ts",
    "src/main/security/**",
    "src/main/index.ts",
    "src/main/window.ts",
    "src/main/crash-policy.ts",
    "src/main/paths.ts",
    "src/main/protocol.ts",
    "src/main/user-agent.ts",
    "src/main/user-data.ts",
    "src/main/local-data.ts",
    "src/main/logging.ts",
    "src/main/log-mask.ts",
    "src/main/errors.ts",
    "src/main/db/**",
    "src/renderer/index.html",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/lib/**",
    "src/renderer/src/app/Layout.tsx",
    "src/renderer/src/app/router.tsx",
    "src/renderer/src/app/navigation.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/src/App.tsx",
    "package.json",
    "package-lock.json",
    "electron.vite.config.ts",
    "electron-builder.yml",
    "playwright.config.ts",
    "tsconfig*.json",
    ".gitattributes",
    "build/**",
    "e2e/areas.json"
  ],
  "zones": {
    "@smoke": "smoke.spec.ts: arranque, protocolo, preload, CSP e instancia única",
    "@shell": "shell.spec.ts: menú, barra superior, tema, idioma y paleta",
    "@tenants": "tenants.spec.ts: clientes, entornos y secretos",
    "@tls": "tls.spec.ts: certificados y conexión",
    "@errors": "pantallas de error (errors.spec.ts y «Copiar detalles»)",
    "@vistas-comun": "lo común a las vistas: sin entorno, cambiar de entorno, rango personalizado, errores de Dynatrace, capturas y ventana",
    "@inicio": "Inicio: problemas abiertos, SLOs y salud de servicios",
    "@problemas": "la lista de Problemas: tabla, filtros, línea de tiempo y exportación de la lista",
    "@problema-detalle": "el detalle del problema: evidencias, descripción, comentarios y mini gráficos",
    "@metricas": "Métricas: consulta, gráfico, consultas guardadas y captura",
    "@entidad": "lo común a las páginas de entidad: «Analizar entidad», página genérica, orden de secciones y etiquetas",
    "@servicio": "página del servicio y sus canales por IPC",
    "@host": "página del host y del disco, y sus canales",
    "@proceso": "página del proceso y del process group, y sus canales",
    "@monitor": "páginas de browser y HTTP monitor, y sus canales",
    "@aplicacion": "página de la aplicación web, y sus canales"
  },
  "resourceTags": {
    "@portapapeles": "lee o escribe el portapapeles del sistema"
  },
  "areas": {
    "smoke": {
      "globs": ["src/main/ipc/handlers/app.ts"],
      "specs": ["e2e/smoke.spec.ts"]
    },
    "tenants": {
      "globs": [
        "src/main/tenants/**",
        "src/main/secrets/**",
        "src/main/settings/**",
        "src/main/ipc/handlers/tenants.ts",
        "src/shared/tenants.ts",
        "src/renderer/src/settings/**",
