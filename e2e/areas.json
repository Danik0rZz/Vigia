        "src/renderer/src/components/TopBar.tsx",
        "src/renderer/src/app/problem-filters.ts",
        "src/renderer/src/app/page-crumb.ts",
        "src/renderer/src/components/PageHeader.tsx",
        "src/renderer/src/components/TimeRangeSelector.tsx",
        "src/renderer/src/components/CommandPalette.tsx",
        "src/renderer/src/data/modules.ts",
        "src/renderer/src/data/query-list.ts",
        "src/renderer/src/app/time-range.ts",
