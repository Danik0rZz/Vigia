{
  "name": "vigia",
  "version": "0.11.0",
  "description": "Vigía: app de escritorio para trabajar con Dynatrace",
  "main": "./out/main/index.js",
  "author": "Dani",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:nobuild": "playwright test",
    "test:e2e:affected": "node scripts/affected-e2e.cjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
    "build": "npm run typecheck && electron-vite build",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win zip",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "db:generate": "drizzle-kit generate",
    "scan:tenant": "node scripts/scan-tenant.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "electron-log": "5.4.4",
    "exceljs": "4.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.11",
    "echarts": "6.1.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "highlight.js": "11.11.2",
    "i18next": "26.4.2",
    "lowlight": "3.3.0",
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "selfsigned": "5.5.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "private": true,
  "productName": "Vigía",
  "engines": {
    "node": ">=22"
  }
}
